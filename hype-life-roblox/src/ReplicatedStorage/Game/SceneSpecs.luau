	{ words = { "牛排", "餐厅" }, scene = "restaurant" },
	{ words = { "机场" }, scene = "airport" },
	{ words = { "办公室", "中关村", "会议室", "财务", "咖啡", "片场" }, scene = "office" },
}

function SceneSpecs.resolve(sceneText: string): string
	for _, entry in ipairs(SceneSpecs.KEYWORDS) do
		for _, word in ipairs(entry.words) do
			if string.find(sceneText, word, 1, true) then
				return entry.scene
			end
		end
	end
	return "office"
end

-- 颜色简写
local function rgb(r: number, g: number, b: number)
	return { r, g, b }
end

