-- 事件卡 scene 文案 → 摄影棚原型
function SceneSpecs.sceneFor(sceneText: string): string
	for _, entry in ipairs(SceneSpecs.KEYWORDS) do
		for _, word in ipairs(entry.words) do
			if string.find(sceneText, word, 1, true) then
				return entry.scene
			end
		end
	end
	return "office"
end

return SceneSpecs
